# Datenbank
# - Lokal: file:local.db
# - Produktiv (Turso): libsql://<dein-db-name>-<dein-user>.turso.io
DATABASE_URL=file:local.db
# Nur in Produktion (Turso) gesetzt – lokal leer lassen
DATABASE_AUTH_TOKEN=

# Matomo-Anbindung
MATOMO_BASE_URL=https://deine-matomo-instanz.de
MATOMO_API_TOKEN=dein-matomo-api-token
DEFAULT_MATOMO_SITE_ID=1

# NextAuth (Pflicht – beliebige lange Zeichenkette, z.B. aus random.org)
NEXTAUTH_SECRET=min-32-zeichen-langer-zufaelliger-string
NEXTAUTH_URL=http://localhost:3000
