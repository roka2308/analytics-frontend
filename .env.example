# Datenbank
# - Lokal: file:local.db
# - Produktiv (Turso): libsql://<dein-db-name>-<dein-user>.turso.io
DATABASE_URL=file:local.db
# Nur in Produktion (Turso) gesetzt – lokal leer lassen
DATABASE_AUTH_TOKEN=

# Matomo-Anbindung
MATOMO_BASE_URL=https://deine-matomo-instanz.de
MATOMO_API_TOKEN=dein-matomo-api-token
DEFAULT_MATOMO_SITE_ID=1

# NextAuth (Pflicht – beliebige lange Zeichenkette, z.B. aus random.org)
NEXTAUTH_SECRET=min-32-zeichen-langer-zufaelliger-string
NEXTAUTH_URL=http://localhost:3000

# Cache-Vorwaermen: Secret fuer den geschuetzten Endpunkt /api/cron/warm.
# Ein beliebiger Cron/Pinger ruft GET /api/cron/warm?secret=<CRON_SECRET> auf.
# Ohne CRON_SECRET ist der Endpunkt nur fuer eingeloggte Admins erreichbar.
CRON_SECRET=

# E-Commerce-Datenbank der Kollegin (MySQL) – NUR serverseitig genutzt.
# Wird erst beim ersten SQL-Abruf gebraucht; ohne diese Werte laeuft der
# Rest der App normal weiter (nur SQL-Views liefern dann einen Fehler).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Optional: Pool-Groesse und TLS fuer Remote-Hosts
MYSQL_POOL_SIZE=5
MYSQL_SSL=false
